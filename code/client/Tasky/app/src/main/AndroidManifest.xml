<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icona"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icona_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tasky">
        <activity
            android:name=".ui.screens.LoginActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="@string/title_activity_login" />
        <activity
            android:name=".ui.screens.DepartmentActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="DepartmentActivity" />
        <activity
            android:name=".ui.screens.ListViewer"
            android:exported="false"
            android:label="DepartmentActivity" />
        <activity
            android:name=".ui.screens.InfoViewer"
            android:exported="false"
            android:label="DepartmentActivity" />
        <activity
            android:name=".ui.screens.HomeDipendenteActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="HomeDipendenteActivity" />
        <activity
            android:name=".ui.screens.HomeManagerActivity"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="HomeManagerActivity" />
        <activity
            android:name=".ui.screens.Adder"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="Adder" />
        <activity
            android:name=".ui.screens.TaskSospender"
            android:screenOrientation="portrait"
            android:exported="false"
            android:label="TaskSospender" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Tasky">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>